# Server-only settings. Set these in Vercel, not in browser code.
SITE_URL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Generate a random password of at least 32 characters. Login username: owner
TIKTOK_ADMIN_PASSWORD=
# Exactly 64 hexadecimal characters (32 random bytes); keep stable after connecting.
TIKTOK_ENCRYPTION_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: restrict authorization to one TikTok app-scoped owner ID.
TIKTOK_OWNER_OPEN_ID=
